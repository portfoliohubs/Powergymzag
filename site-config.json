    "slogan": "Train smart. Lift strong. Repeat."
  },
  "permalinks": {},
  "pluralizelisttitles": true,
  "privacy": {
    "disqus": {},
    "googleanalytics": {},
    "instagram": {},
    "twitter": {},
    "vimeo": {},
    "youtube": {}
  },
  "publishdir": "public",
  "related": {
    "indices": [
      {
        "name": "keywords",
        "type": "basic",
        "weight": 100
      },
      {
        "name": "date",
        "type": "basic",
        "weight": 10
      }
    ],
    "threshold": 80
  },
  "relativeurls": true,
  "resourcedir": "resources",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass(-embedded)?$",
        "^go$",
        "^npx$",
        "^postcss$"
      ],
      "osenv": [
        "(?i)^((HTTPS?|NO)_PROXY|PATH(EXT)?|APPDATA|TE?MP|TERM|GO\\w+|(XDG_CONFIG_)?HOME|USERPROFILE|SSH_AUTH_SOCK|DISPLAY|LANG|SYSTEMDRIVE)$"
      ]
    },
    "funcs": {
      "getenv": [
        "^HUGO_",
        "^CI$"
      ]
    },
    "http": {
      "methods": [
        "(?i)GET|POST"
      ],
      "urls": [
        ".*"
      ]
    }
  },
  "server": {
    "redirects": [
      {
        "from": "**",
        "status": 404,
        "to": "/404.html"
      }
    ]
  },
  "services": {
    "disqus": {},
    "googleanalytics": {},
    "instagram": {},
    "rss": {
      "limit": -1
    },
    "twitter": {}
  },
  "sitemap": {
    "filename": "sitemap.xml",
    "priority": -1
  },
  "staticdir": [
    "static"
  ],
  "summarylength": 70,
  "themesdir": "themes",
  "timeout": "30s",
  "title": "Gym Training",
  "titlecasestyle": "AP",
  "workingdir": "/home/runner/work/Powergymzag/Powergymzag"
}
